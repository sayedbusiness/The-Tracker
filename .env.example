# ─────────────────────────────────────────────────────────────
# APEX OS — Environment Variables
# Copy to .env.local and fill in for full functionality.
# The app runs with mock data if these are unset (dev mode).
# ─────────────────────────────────────────────────────────────

# Site password — gates the entire app behind a login screen.
# Leave EMPTY in local dev to skip the gate. Set in Vercel to lock
# the deployed URL to anyone who doesn't know this password.
APEX_PASSWORD=""

# Database (Postgres via Supabase recommended)
DATABASE_URL="postgresql://user:pass@host:5432/apexos"
DIRECT_URL="postgresql://user:pass@host:5432/apexos"

# Cross-device sync uses Supabase (free tier).
# Requires the same NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# already documented below, plus a one-time `apex_state` table.
# See DEPLOY.md → "🔄 Cross-device sync" for the 30-second SQL setup.

# Auth (Supabase or Clerk)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI — Anthropic Claude (primary brain)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"

# AI — Vector memory
PINECONE_API_KEY=""
PINECONE_INDEX="apex-memory"

# Vision (food recognition) — Google Gemini 2.5
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Push notifications
EXPO_ACCESS_TOKEN=""

# ─── Twilio — in-app dialer + texting (Agency / CRM page) ───
# Server-only. NEVER commit real values; set these in Vercel env vars.
# Rotate the API secret immediately if it's ever shared/exposed.
TWILIO_ACCOUNT_SID=""      # AC… (Account SID)
TWILIO_API_KEY_SID=""      # SK… (Standard API Key SID)
TWILIO_API_KEY_SECRET=""   # the API Key secret
TWILIO_TWIML_APP_SID=""    # AP… (TwiML App for browser Voice)
TWILIO_PHONE_NUMBER=""     # +1… (E.164 — caller ID + SMS "from")

# Google Calendar OAuth — for /calendar page
# Create at console.cloud.google.com (see DEPLOY.md). Redirect URI
# must match exactly what you register there.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Wearables
HEALTHKIT_TEAM_ID=""
GOOGLE_FIT_CLIENT_ID=""

# Analytics
POSTHOG_KEY=""
